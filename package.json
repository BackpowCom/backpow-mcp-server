{
  "name": "@backpow/mcp-server",
  "mcpName": "com.backpow/pow-oracle",
  "version": "1.0.0",
  "description": "The official Model Context Protocol (MCP) server for BackPow - The Proof of Work Oracle",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "backpow-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "conformance": "node scripts/conformance.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "modelcontextprotocol",
    "claude",
    "llm",
    "ai-agent",
    "ai",
    "proof-of-work",
    "pow",
    "mining",
    "solo-mining",
    "hashrate",
    "difficulty",
    "cost-of-production",
    "mining-hardware",
    "asic",
    "gpu-mining",
    "crypto",
    "cryptocurrency",
    "blockchain",
    "bitcoin",
    "oracle",
    "backpow",
    "cloudflare-workers"
  ],
  "author": "BackPow",
  "license": "MIT",
  "homepage": "https://backpow.com/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BackpowCom/backpow-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/BackpowCom/backpow-mcp-server/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^22.20.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.134.0"
  }
}
